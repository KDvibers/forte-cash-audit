# Reference only: the server DOES NOT automatically load this file.
# In PowerShell set, for example: $env:CASH_AUDIT_MAX_UPLOAD_MB = '100'
# start.ps1 -Mode and -Scenario override the corresponding environment variables.

CASH_AUDIT_MODE=real
CASH_AUDIT_MOCK_SCENARIO=one
CASH_AUDIT_MOCK_DELAY_SECONDS=2
CASH_AUDIT_MAX_UPLOAD_MB=100
CASH_AUDIT_MAX_PENDING_JOBS=2
CASH_AUDIT_UPLOAD_RATE_PER_MINUTE=12
CASH_AUDIT_JOB_TIMEOUT_SECONDS=285
CASH_AUDIT_WORKER_STARTUP_SECONDS=90
CASH_AUDIT_RETENTION_HOURS=24

# Optional: otherwise a random persistent key is stored in backend/.local/api-key.txt.
# CASH_AUDIT_API_KEY=use-your-own-random-key-at-least-16-characters
# Optional: otherwise backend/.local next to the source files.
# CASH_AUDIT_DATA_DIR=C:\forte-audit-data
# Optional ffprobe binary. First-frame decoding always uses imageio-ffmpeg.
# CASH_AUDIT_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
